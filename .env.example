# ==============================================================================
# Fandoq Culinary & Pastry Academy - Environment Configuration Template
# سامانه آموزشگاه شیرینی و آشپزی فندق - تنظیمات متغیرهای محیطی
# ==============================================================================

# Server Network Settings
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL Database Configuration
# در صورت اجرای داکر، نام هاست برابر با اسم سرویس داکر یعنی 'postgres' است
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fandoq_db
POSTGRES_USER=fandoq_user
POSTGRES_PASSWORD=fandoq_secure_pass_2025
# اختیاری: برای اتصال‌های ابری (مانند Supabase, Neon, Cloud SQL)
# DATABASE_URL=postgresql://fandoq_user:fandoq_secure_pass_2025@postgres:5432/fandoq_db

# Security & Authentication (JWT)
# هشدار: این کلید را در محیط پروداکشن حتماً با یک رشته تصادفی و پیچیده جایگزین کنید
JWT_SECRET=fandoq_super_secure_production_jwt_secret_key_random_string_2025
JWT_EXPIRES_IN=7d

# Default System Administrator Account (Seeded on first run)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=fandoq@2025

# Iranian SMS Providers (Optional Integration for OTP & Notifications)
# KAVENEGAR_API_KEY=your_kavenegar_api_key_here
# FARAZ_SMS_API_KEY=your_faraz_api_key_here
